# Shared passcode for the five people using the app.
APP_PASSCODE=choose-a-private-passcode

# Use a long random value. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Optional. This verified low-cost model is used when the value is omitted.
AI_MODEL=google/gemini-2.5-flash-lite

# For local development outside Vercel, add an AI Gateway API key.
# AI_GATEWAY_API_KEY=
